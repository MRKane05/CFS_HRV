<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_measure">

    <fragment
        android:id="@+id/navigation_measure"
        android:name="com.vitahot.ms_battery_nz.ui.measure.MeasureFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_measure_to_navigation_symptoms"
            app:destination="@+id/navigation_symptoms" />
    </fragment>

    <fragment
        android:id="@+id/navigation_symptoms"
        android:name="com.vitahot.ms_battery_nz.ui.symptoms.SymptomsFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

</navigation>